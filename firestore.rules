rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidApplication(data) {
      return data.applicationId is string &&
             data.name is string && data.name.size() > 0 &&
             data.mobile is string && data.mobile.size() == 10 &&
             data.bikeAvailable is bool &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.trainingDate is string &&
             data.submittedAt is number;
    }

    match /applications/{applicationId} {
      // Allow reading application details for tracking and admin verification
      allow read: if true;

      // Allow creating an application during registration
      allow create: if isValidApplication(request.resource.data) &&
                       request.resource.data.applicationId == applicationId &&
                       request.resource.data.status == 'PENDING';

      // Allow admin updates (approval / rejection status updates)
      allow update: if request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
                       request.resource.data.applicationId == applicationId;

      // Restrict deletion
      allow delete: if false;
    }
  }
}
